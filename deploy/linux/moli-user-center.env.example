# user-center 运行环境配置
# 复制: cp moli-user-center.env.example /opt/moli-project-distribute/moli-user-center/conf/moli-user-center.env
# chmod 600 .../moli-user-center.env

MOLI_DEPLOY_ROOT=/opt/moli-project-distribute
APP_HOME=/opt/moli-project-distribute/moli-user-center

JAR_FILE=
PID_FILE=/opt/moli-project-distribute/moli-user-center/run/user-center.pid
LOG_DIR=/opt/moli-project-distribute/moli-user-center/logs
LOG_FILE=/opt/moli-project-distribute/moli-user-center/logs/user-center.log

# ---------- Java（与 moli-server.env.example 相同）----------
# 可指定 JAVA_HOME，脚本会优先使用 $JAVA_HOME/bin/java
JAVA_HOME=/usr/lib/jvm/java-11-amazon-corretto
JAVA_CMD=java
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"

SPRING_PROFILES_ACTIVE=pro
SPRING_ARGS=

SSO_SHARED_SECRET=请替换为随机强密钥

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moli
SPRING_DATASOURCE_USERNAME=moli
SPRING_DATASOURCE_PASSWORD=请替换为MySQL密码

SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_DATABASE=1

NACOS_SERVER_ADDR=http://127.0.0.1:8848
NACOS_NAMESPACE=prod
NACOS_USERNAME=nacos
NACOS_PASSWORD=请替换为Nacos密码

STOP_TIMEOUT=30
