# gateway 运行环境配置
# 复制: cp moli-gateway.env.example /opt/moli-project-distribute/moli-gateway/conf/moli-gateway.env

MOLI_DEPLOY_ROOT=/opt/moli-project-distribute
APP_HOME=/opt/moli-project-distribute/moli-gateway

JAR_FILE=
PID_FILE=/opt/moli-project-distribute/moli-gateway/run/gateway.pid
LOG_DIR=/opt/moli-project-distribute/moli-gateway/logs
LOG_FILE=/opt/moli-project-distribute/moli-gateway/logs/moli-gateway.log

# ---------- Java ----------
JAVA_HOME=/usr/lib/jvm/java-11-amazon-corretto
JAVA_CMD=java
JAVA_OPTS="-Xms256m -Xmx512m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"

SPRING_PROFILES_ACTIVE=pro
SPRING_ARGS=
SERVER_PORT=28100

NACOS_SERVER_ADDR=127.0.0.1:28548
NACOS_NAMESPACE=prod
NACOS_USERNAME=nacos
NACOS_PASSWORD=请替换为Nacos密码

# ---------- SkyWalking（默认关闭）----------
SKYWALKING_ENABLED=false
SKYWALKING_AGENT_PATH=/opt/skywalking-agent/skywalking-agent.jar
SKYWALKING_SERVICE_NAME=moli-gateway
SKYWALKING_BACKEND_SERVICE=127.0.0.1:11800
SKYWALKING_SAMPLE_N_PER_3_SECS=100

STOP_TIMEOUT=30
