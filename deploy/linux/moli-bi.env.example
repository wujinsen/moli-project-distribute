# bi 运行环境配置（部署目录 moli-ai，artifact moli-bi-server）
# 复制: cp moli-bi.env.example /opt/moli-project-distribute/moli-ai/conf/moli-bi.env

MOLI_DEPLOY_ROOT=/opt/moli-project-distribute
APP_HOME=/opt/moli-project-distribute/moli-ai

JAR_FILE=
PID_FILE=/opt/moli-project-distribute/moli-ai/run/bi.pid
LOG_DIR=/opt/moli-project-distribute/moli-ai/logs
LOG_FILE=/opt/moli-project-distribute/moli-ai/logs/bi.log

# ---------- Java ----------
JAVA_HOME=/usr/lib/jvm/java-11-amazon-corretto
JAVA_CMD=java
JAVA_OPTS="-Xms256m -Xmx512m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"

SPRING_PROFILES_ACTIVE=pro
SPRING_ARGS=
SERVER_PORT=1128

NACOS_SERVER_ADDR=http://127.0.0.1:8848
NACOS_NAMESPACE=prod
NACOS_USERNAME=nacos
NACOS_PASSWORD=请替换为Nacos密码

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/moli?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=请替换为数据库密码

STOP_TIMEOUT=30
