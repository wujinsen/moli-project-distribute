# knowledge-server 生产环境变量
# 复制: cp knowledge.env.example /opt/moli-project-distribute/moli-knowledge/conf/moli-knowledge.env
#
# 前置: monorepo 在 /opt/moli-project-distribute，含 moli-knowledge/kb/

MOLI_ROOT=/opt/moli-project-distribute
APP_HOME=/opt/moli-project-distribute/moli-knowledge
JAR_FILE=
PID_FILE=/opt/moli-project-distribute/moli-knowledge/run/knowledge.pid
LOG_DIR=/opt/moli-project-distribute/moli-knowledge/logs
LOG_FILE=/opt/moli-project-distribute/moli-knowledge/logs/knowledge.log

JAVA_CMD=java
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"

SPRING_PROFILES_ACTIVE=pro
SPRING_ARGS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moli
SPRING_DATASOURCE_USERNAME=moli
SPRING_DATASOURCE_PASSWORD=请替换为MySQL密码

SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_DATABASE=1

NACOS_SERVER_ADDR=http://127.0.0.1:8848
NACOS_NAMESPACE=prod
NACOS_USERNAME=nacos
NACOS_PASSWORD=请替换为Nacos密码

KB_WIKI_ROOT=/opt/moli-project-distribute/moli-knowledge/kb
KB_RAW_ROOT=/opt/moli-project-distribute/moli-knowledge/kb/raw
KB_SYNC_SCRIPT_PATH=/opt/moli-project-distribute/moli-knowledge/kb/tools/sync_to_db.py
KB_LINT_SCRIPT_PATH=/opt/moli-project-distribute/moli-knowledge/kb/tools/lint.py
KB_SYNC_PYTHON=python3

KB_LLM_ENABLED=true
KB_LLM_API_KEY=
KB_LLM_CONFIG_SECRET=请替换为32字节随机密钥

MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=moli-knowledge

KB_INGEST_ENABLED=true

STOP_TIMEOUT=30
