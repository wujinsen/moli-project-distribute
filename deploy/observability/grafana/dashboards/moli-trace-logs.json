        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "{service=~\"$moli_services\"} |= \"$trace_id\" |= \"Preparing\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "全链路 SQL（MyBatis Preparing）",
      "type": "logs"
    }
  ],
