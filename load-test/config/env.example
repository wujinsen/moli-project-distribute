# Copy to .env and adjust for your cluster
BASE_URL=http://localhost:21000
ACTIVITY_ID=1
TARGET_RPS=10000
DURATION=5m
WORKERS=100
K6_OUT=influxdb=http://influxdb:8086/k6

# Prometheus scrape targets (host services, loadtest profile)
GATEWAY_METRICS=http://localhost:21000/actuator/prometheus
USER_CENTER_METRICS=http://localhost:8888/actuator/prometheus
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
