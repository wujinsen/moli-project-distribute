#!/usr/bin/env python3
"""沙箱里的假网关服务。

行为要足够像真的，诊断才有意义：监听端口、持续写结构化日志、
可以按控制文件进入「内存泄漏」「CPU 打满」等病态模式。
故障注入改的是控制文件，服务自己表现出症状——而不是外部伪造日志。
"""

from __future__ import annotations

import json
import os
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

PORT = int(os.environ.get("GATEWAY_PORT", "8080"))
LOG = Path("/var/log/moli/gateway.log")
FAULT = Path("/var/run/moli/gateway.fault")

_leak: list[bytes] = []


def log(level: str, message: str) -> None:
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {level} [moli-gateway] {message}"
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a", encoding="utf-8") as handle:
        handle.write(line + "\n")


def fault_mode() -> str:
    try:
        return FAULT.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:  # noqa: N802
        mode = fault_mode()
        if self.path.startswith("/actuator/health"):
            healthy = mode not in {"oom", "cpu"}
            self.send_response(200 if healthy else 503)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(
                json.dumps({"status": "UP" if healthy else "DOWN"}).encode()
            )
            return
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"moli-gateway ok")

    def log_message(self, *args) -> None:  # noqa: ANN002
        return


def heartbeat() -> None:
    """按当前故障模式持续产生对应的日志特征，供诊断链路检索。"""
    while True:
        mode = fault_mode()
        if mode == "oom":
            _leak.append(b"x" * 4 * 1024 * 1024)
            log("ERROR", "java.lang.OutOfMemoryError: Java heap space")
            log("ERROR", "\tat com.moli.gateway.filter.AuthFilter.doFilter(AuthFilter.java:88)")
        elif mode == "cpu":
            log("WARN", "request queue depth=812, p99=9840ms, rejecting new connections")
        elif mode == "disk":
            log("ERROR", "Failed to write access log: No space left on device")
        elif mode == "db":
            log("ERROR",
                "com.mysql.cj.jdbc.exceptions.CommunicationsException: "
                "Communications link failure — Connection refused (moli-mysql:3306)")
        else:
            log("INFO", "heartbeat ok, active_connections=12, p99=38ms")
        time.sleep(3)


def burn_cpu() -> None:
    while True:
        if fault_mode() == "cpu":
            end = time.monotonic() + 0.9
            while time.monotonic() < end:
                pow(1.0000001, 900000)
        time.sleep(0.1)


def main() -> None:
    log("INFO", f"moli-gateway starting on :{PORT}")
    threading.Thread(target=heartbeat, daemon=True).start()
    threading.Thread(target=burn_cpu, daemon=True).start()
    threading.Thread(target=burn_cpu, daemon=True).start()
    HTTPServer(("0.0.0.0", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
