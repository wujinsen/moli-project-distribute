# moli-aiops 配置样例。复制为 .env 后按需改，或直接 export 到环境变量。
# 全部有默认值，一个都不配也能起服务（走本地 inventory + 规则兜底）。

# ============ 安全（最要紧的四个）============

# 处置总开关。对应 user-center 的 ops.command.enabled，事故时可立即关停。
# 关闭时只读取证照常，只是不能改任何东西。
OPS_EXEC_ENABLED=false

# 即便拿到审批令牌，destructive 级命令是否放行。默认永不。
OPS_ALLOW_DESTRUCTIVE=false

# 审批令牌 HMAC 签名密钥。不配则用进程内随机值，服务重启后已签发的令牌全部失效。
# 生产必须配，否则多实例部署时令牌无法跨实例校验。
OPS_APPROVAL_SECRET=

# 令牌有效期（秒）。人审批后超过这个时间没执行就要重新批。
OPS_APPROVAL_TTL_S=600

# 人已审批也仍然只干跑不真执行。首次接生产建议先开着跑几天。
AIOPS_FORCE_DRY_RUN=false


# ============ CMDB 数据源 ============

# auto：先探 user-center REST，不可达时回退本地 inventory.yaml
# rest / file：强制指定
OPS_CMDB_MODE=auto

OPS_USER_CENTER_BASE_URL=http://127.0.0.1:21000/UserCenterServer
# user-center 登录后的 Shiro sessionId
OPS_AUTH_TOKEN=

# SSH 凭据、日志路径白名单、服务声明都在这里，恒定留在本地，不经过 REST
OPS_INVENTORY=inventory.yaml
OPS_CMDB_TIMEOUT_S=10


# ============ SSH ============

OPS_SSH_CONNECT_TIMEOUT_S=8
OPS_SSH_COMMAND_TIMEOUT_S=30
# 单条命令回传上限，防止 tail 一个巨型日志把内存和 LLM 上下文打爆
OPS_SSH_MAX_OUTPUT_BYTES=262144


# ============ 知识库检索（复用 moli-knowledge）============

KB_BASE_URL=http://127.0.0.1:8090
KB_AUTH_TOKEN=
OPS_KB_TIMEOUT_S=20


# ============ 服务与存储 ============

AIOPS_HOST=127.0.0.1
AIOPS_PORT=8099

# meiling-ui 整合：入站 Shiro 校验（默认开启）
# 独立演示 static/index.html 时可设 true 跳过
AIOPS_AUTH_DISABLED=false
# user-center 权限快照；dev 直连 :8888，生产可改为网关 UserCenter
AIOPS_AUTH_VALIDATE_URL=http://127.0.0.1:8888/auth/capabilities
AIOPS_AUTH_TIMEOUT_S=8
# meiling-ui dev 源（CORS）
AIOPS_CORS_ORIGINS=http://localhost:5141,http://127.0.0.1:5141

# trace 与工具层审计共用一个文件，方便按 incident_id 把两边串起来看
OPS_AUDIT_DB=data/aiops.db
# LangGraph checkpoint：单步重跑与回放依赖它
AIOPS_CHECKPOINT_DB=data/checkpoints.db


# ============ 编排行为 ============

# 单次诊断的时间预算（毫秒），超了就出降级结论而不是无限查下去
AIOPS_LATENCY_BUDGET_MS=180000
# critic 判定证据不足时最多回补几轮
AIOPS_MAX_INVESTIGATE_ROUNDS=2
AIOPS_MAX_HYPOTHESES=4


# ============ LLM 厂商链 ============

# 逗号分隔，顺序即优先级。留空则全程走规则兜底（链路照样跑完，结论质量下降）。
# 每个厂商按 AIOPS_{名字大写}_ 前缀读配置。
AIOPS_PROVIDERS=

# AIOPS_PROVIDERS=deepseek,openai
# AIOPS_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# AIOPS_DEEPSEEK_API_KEY=sk-xxx
# AIOPS_DEEPSEEK_MODEL_REASONING=deepseek-reasoner
# AIOPS_DEEPSEEK_MODEL_FAST=deepseek-chat
# AIOPS_OPENAI_BASE_URL=https://api.openai.com/v1
# AIOPS_OPENAI_API_KEY=sk-xxx
# AIOPS_OPENAI_MODEL_REASONING=gpt-4o
# AIOPS_OPENAI_MODEL_FAST=gpt-4o-mini

# 没配 AIOPS_PROVIDERS 时，会兼容 deep_research 已有的 OPENAI_* 约定，
# 省得同一台机器配两套。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 分档超时与重试
AIOPS_LLM_REASONING_TIMEOUT_S=90
AIOPS_LLM_FAST_TIMEOUT_S=45
AIOPS_LLM_ATTEMPTS=2
AIOPS_LLM_BACKOFF_S=1.0
