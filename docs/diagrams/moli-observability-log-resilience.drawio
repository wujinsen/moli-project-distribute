<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="moli-observability-log-resilience" name="日志可靠性分层">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="茉莉 · 日志可靠性分层与故障影响" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <mxCell id="L1" value="L1 · 本地落盘（真相源 · 必须）" style="swimlane;html=1;startSize=28;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="2000" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L1-box" value="Logback → logs/{service}.log&#xa;滚动 · 磁盘监控 · Slf4jImpl&#xa;Alloy/Loki/Grafana 全挂也不影响写入" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="L1">
          <mxGeometry x="40" y="45" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="L1-fail" value="风险：磁盘满 · 权限 · 未滚动导致单文件过大&#xa;对策：告警 &gt;80% · logback maxHistory · SSH tail/grep 兜底" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="L1">
          <mxGeometry x="520" y="45" width="480" height="70" as="geometry" />
        </mxCell>

        <mxCell id="L2" value="L2 · 采集层 Alloy（异步 · 可恢复）" style="swimlane;html=1;startSize=28;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="2000" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L2-box" value="systemd 托管 · 文件 offset/WAL&#xa;停机期间 log 仍写盘 · 恢复后补采&#xa;Loki 慢时背压/丢弃远程，不拖垮 JVM" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="L2">
          <mxGeometry x="40" y="45" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="L2-fail" value="风险：Alloy down · down -v 清 WAL · 滚动截断漏段&#xa;对策：Restart=always · 禁止 -v · 滚动前确保 offset 已推或文件仍可读" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="L2">
          <mxGeometry x="520" y="45" width="520" height="70" as="geometry" />
        </mxCell>

        <mxCell id="L3" value="L3 · Loki + 对象存储（热查询 · 生产必升级）" style="swimlane;html=1;startSize=28;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="2000" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L3-box" value="Grafana Explore · LogQL · retention 15–30d&#xa;PoC：filesystem 卷 · 生产：S3/MinIO/COS chunks&#xa;容器重建不丢库（对象存储多副本）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="L3">
          <mxGeometry x="40" y="45" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="L3-fail" value="风险：down -v · 单机盘满 · retention 到期自动删&#xa;对策：对象存储 · 禁止 -v · 容量压测 · ERROR 更长保留" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="L3">
          <mxGeometry x="560" y="45" width="480" height="70" as="geometry" />
        </mxCell>

        <mxCell id="L4" value="L4 · 冷归档（可选 · 合规 90d+）" style="swimlane;html=1;startSize=28;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="2000" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L4-box" value="cron/rsync ERROR 日志 → OSS Glacier&#xa;Loki 查不到的历史 · 离线审计" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="L4">
          <mxGeometry x="40" y="45" width="420" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="L1" target="L2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="L2" target="L3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="L3" target="L4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="matrix-title" value="常见操作 vs 数据是否丢失" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="matrix" value="docker compose stop          → Loki 卷保留 · 本地 log 保留&#xa;docker compose down          → 卷保留（无 -v）· 本地 log 保留&#xa;docker compose down -v       → Loki 数据丢失 · 本地 log 仍在&#xa;Alloy 停机                   → 远程暂不可查 · 恢复后补采 · 本地 log 仍在&#xa;Grafana 故障                 → 仅影响看板 · Loki/本地 log 仍在" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="755" width="720" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
