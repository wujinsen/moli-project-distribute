<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="moli-observability-platform" name="可观测性平台">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="茉莉可观测性平台 · Metrics / Logs / Traces" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="trace_id 贯穿端到端调用 · span_id 精确定位当前操作 · 指标/日志/链路职责分离" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="1100" height="28" as="geometry" />
        </mxCell>

        <mxCell id="apps" value="L1 · 业务服务（281xx）" style="swimlane;html=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;horizontal=1;" vertex="1" parent="1">
