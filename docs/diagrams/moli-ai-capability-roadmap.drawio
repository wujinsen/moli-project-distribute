<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="moli-ai-capability-roadmap" name="AI Capability Roadmap">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;茉莉 AI 能力升级 · 四波路线（AI-1 ~ AI-10）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666;&quot;&gt;评测先行 → 语义检索 → ChatBI 业务落地 → 差异化检索 → 可信与前沿；起始 2026-07-20，每波 4 周&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="axis" value="" style="endArrow=block;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="120" as="sourcePoint" />
            <mxPoint x="1840" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="w1" value="v1.1 语义检索&#xa;W1–W4 · 07-20 ~ 08-14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="v1.2 ChatBI&#xa;W5–W8 · 08-17 ~ 09-11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="150" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="v1.3 差异化检索&#xa;W9–W12 · 09-14 ~ 10-09" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="150" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="v2.0 可信与前沿&#xa;W13–W16 · 10-12 ~ 11-06" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1380" y="150" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ai1" value="&lt;b&gt;AI-1&lt;/b&gt; 评测扩容&#xa;golden 12→≥50，脏 query + 拒答负样本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ai2" value="&lt;b&gt;AI-2&lt;/b&gt; 向量 + Hybrid + Rerank&#xa;ngram+向量双路 RRF 融合，三档可回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="340" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ai3" value="&lt;b&gt;AI-3&lt;/b&gt; Eval 回归看板 + CI 门禁&#xa;kb_eval_run 落库 · 趋势曲线 · gate-at-k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ai4" value="&lt;b&gt;AI-4&lt;/b&gt; ChatBI / NL2SQL Agent&#xa;ai-server 0→1；只读账号 + SQL 白名单&#xa;接 order/user 真实库；执行正确率 ≥80%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="250" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ai5" value="&lt;b&gt;AI-5&lt;/b&gt; GraphRAG&#xa;沿 kb_relation 扩 N 跳（既有图谱资产）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="250" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ai6" value="&lt;b&gt;AI-6&lt;/b&gt; 知识库 MCP Server&#xa;kb.search/ask/graph 工具，Cursor 直连" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="340" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ai7" value="&lt;b&gt;AI-7&lt;/b&gt; Agentic RAG&#xa;查询改写 / 多跳 / 自检 / 引用校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="430" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ai8" value="&lt;b&gt;AI-8&lt;/b&gt; LLM 网关升级&#xa;多 provider 路由 + 语义缓存 + 成本看板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1390" y="250" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ai9" value="&lt;b&gt;AI-9&lt;/b&gt; Guardrails&#xa;grounding 校验 + 注入检测 + PII 脱敏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1390" y="340" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ai10" value="&lt;b&gt;AI-10&lt;/b&gt; Multi-Agent DeepResearch&#xa;规划→检索→撰写→审校→带引用报告回写 kb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1390" y="430" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ms" value="里程碑：M1 检索对比+门禁 → M2 ChatBI Demo → M3 多跳提升+MCP → M4 成本看板+DeepResearch" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="560" width="1720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dep" value="关键路径（尺子先行）：AI-1 → AI-2 → AI-3；AI-5/AI-7 依赖 AI-2；AI-4/AI-6/AI-8 可并行" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="70" y="600" width="1720" height="30" as="geometry" />
