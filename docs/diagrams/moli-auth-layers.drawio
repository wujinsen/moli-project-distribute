<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="auth-layers" name="Auth Layers">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="鉴权分层（茉莉微服务）&#xa;由外到内：网关 → 会话 → 账号状态 → 细粒度权限 → 服务间 RPC" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="1. 网关层&#xa;限流 / CORS / 黑白名单&#xa;moli-gateway :21000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="2. 会话层&#xa;Shiro authc + Redis 共享 Session&#xa;Authorization = sessionId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="3. 请求层&#xa;每次校验账号停用/删除&#xa;AuthenticationFilter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="4. 权限层&#xa;@RequiresPermissions + menu perms + sys_action&#xa;GET /auth/capabilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="5. 服务间层&#xa;Dubbo RPC 内网调用&#xa;不对外暴露 HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note" value="超级管理员 superadmin/admin → *:*:*&#xa;无权限：HTTP 200 + code=10009" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffcc;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="并行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="l2" target="l5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="215" /><mxPoint x="620" y="515" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
