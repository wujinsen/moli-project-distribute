        <mxCell id="e_crud_db" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="crud_api" target="tbl_matrix">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="150" /><mxPoint x="760" y="200" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="e_ui_crud" style="endArrow=block;html=1;rounded=0;strokeWidth=1;dashed=1;" edge="1" parent="1" source="ui_admin" target="crud_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="图例&#xa;─────&#xa;MATCH / MISMATCH / UNMAPPED / SKIPPED&#xa;名称归一化: lower + _→-&#xa;DB 空表 → Java 内置 8 条兜底&#xa;权威: DB &gt; 内置默认 &gt; checklist 文档" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
