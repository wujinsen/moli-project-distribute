        </mxCell>
        <mxCell id="e_comp_provider" style="endArrow=block;html=1;rounded=0;strokeWidth=1;strokeColor=#d6b656;" edge="1" parent="1" source="ledger_component" target="provider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_match_lbl" value="check(name, port)" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="300" width="120" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e_provider_audit" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="provider" target="audit_api">
          <mxGeometry relative="1" as="geometry" />
