        <mxCell id="ui_admin" value="meiling-ui&#xa;operation/port-matrix/index" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="120" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e_db_provider" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="tbl_matrix" target="provider">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="210" /><mxPoint x="400" y="390" /></Array></mxGeometry>
