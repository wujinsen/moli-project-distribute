        <mxCell id="e_db_provider_lbl" value="load / refresh" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="e_db_provider">
          <mxGeometry relative="1" as="geometry"><mxPoint x="10" y="-8" as="offset" /></mxGeometry>
