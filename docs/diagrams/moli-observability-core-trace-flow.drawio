        <mxCell id="e-uc-db" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="uc" target="mysql-uc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-order-store" value="业务读写" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="order" target="biz-store">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1350" y="335" />
              <mxPoint x="1350" y="650" />
              <mxPoint x="2115" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-kb-store" value="业务读写" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="knowledge" target="biz-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="no-edge" value="当前无直接调用证据&#xa;order ⇄ knowledge&#xa;两者是 Gateway 后的并列服务" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="690" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="trace-lane" value="一次典型鉴权业务请求的 Trace 树" style="swimlane;html=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="870" width="2170" height="300" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="S1&#xa;Gateway inbound" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="trace-lane">
          <mxGeometry x="35" y="70" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="S2&#xa;Gateway outbound" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="trace-lane">
          <mxGeometry x="290" y="70" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="S3&#xa;Service inbound" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="trace-lane">
          <mxGeometry x="545" y="70" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="S4&#xa;Redis Session" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="trace-lane">
