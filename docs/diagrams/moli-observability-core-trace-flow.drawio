        <mxCell id="e-kb-starter" value="请求鉴权" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;strokeColor=#82b366;" edge="1" parent="1" source="knowledge" target="starter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-starter-redis" value="Session / Cache" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="starter" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-starter-uc" value="Dubbo UserCenterServer · S5/S6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="starter" target="uc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1645" y="230" />
              <mxPoint x="1125" y="230" />
            </Array>
          </mxGeometry>
