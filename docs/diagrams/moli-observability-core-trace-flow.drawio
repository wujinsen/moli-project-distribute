<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="moli-observability-core-trace-flow" name="核心服务调用链">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Gateway / User Center / Order / Knowledge · 核心调用链与 Span" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="同一 trace_id 贯穿 HTTP → Redis Session → Dubbo 鉴权 → JDBC/业务存储；每次操作具有独立 span_id" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="64" width="1500" height="28" as="geometry" />
        </mxCell>

        <mxCell id="client" value="浏览器 / meiling-ui&#xa;Authorization: Shiro SessionId&#xa;W3C traceparent（如已有）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="190" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="moli-gateway :28100&#xa;Spring Cloud Gateway / WebFlux&#xa;S1 inbound · S2 outbound" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="190" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nacos" value="Nacos :28548&#xa;服务发现 / 实例选择" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="480" y="380" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="uc" value="user-center-server :28101&#xa;HTTP API + Dubbo Provider&#xa;UserServerProvider" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="100" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="order" value="order-server :28102&#xa;HTTP 业务 + Shiro Starter&#xa;S3 inbound" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="280" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="knowledge" value="knowledge-server :28104&#xa;知识库 API + Shiro Starter&#xa;S3 inbound" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="460" width="350" height="110" as="geometry" />
        </mxCell>

        <mxCell id="starter" value="moli-user-center-shiro-starter&#xa;S4 Redis Session&#xa;S5 Dubbo Consumer&#xa;getUserById / getPermissionsByUserId" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1450" y="290" width="390" height="150" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="共享 Redis&#xa;Shiro Session / Cache&#xa;业务缓存" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1990" y="260" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="mysql-uc" value="User Center MySQL&#xa;用户 / 角色 / 权限&#xa;S7 JDBC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1480" y="90" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="biz-store" value="业务存储&#xa;Order / Knowledge MySQL&#xa;Redis / MinIO · S8" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1990" y="480" width="250" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e-client" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=11;" edge="1" parent="1" source="client" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-nacos" value="Discovery" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="gateway" target="nacos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-uc" value="/UserCenter/** · HTTP lb://" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="gateway" target="uc">
          <mxGeometry relative="1" as="geometry" />
