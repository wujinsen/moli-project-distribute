        <mxCell id="e-gw-order" value="/OrderServer/** · HTTP lb://" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="gateway" target="order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-kb" value="/KnowledgeServer/** · HTTP lb://" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="gateway" target="knowledge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-order-starter" value="请求鉴权" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;strokeColor=#82b366;" edge="1" parent="1" source="order" target="starter">
