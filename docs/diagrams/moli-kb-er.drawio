        <mxCell id="title" value="茉莉知识库 · ER 图（14 表）&#xa;逻辑外键（无物理 FK）· 虚线 = 引用 · 外部: sys_user / sys_role" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1">
