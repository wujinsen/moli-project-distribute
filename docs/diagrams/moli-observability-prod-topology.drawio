<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="moli-observability-prod-topology" name="生产可观测性部署拓扑">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="茉莉 · 生产可观测性部署拓扑（业务机 / 监控机分离）" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="PoC 单机 Docker ≠ 生产；日志真相源在业务机磁盘，Loki 为查询加速层" style="text;html=1;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="58" width="1200" height="28" as="geometry" />
        </mxCell>

        <mxCell id="app-host" value="业务主机 × N（CVM / EC2）" style="swimlane;html=1;startSize=32;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="1080" height="420" as="geometry" />
        </mxCell>
        <mxCell id="jvm" value="Java 服务（JAR / systemd）&#xa;gateway · user-center · order · ai · knowledge&#xa;HTTP 28100–28104 · 内网" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app-host">
          <mxGeometry x="40" y="55" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="logback" value="Logback FILE&#xa;/opt/moli-project-distribute/&#xa;moli-*/logs/{service}.log&#xa;MyBatis Slf4jImpl · 滚动保留 7–30d" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="app-host">
          <mxGeometry x="400" y="55" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="alloy" value="Grafana Alloy（systemd）&#xa;tail *.log · 本地 WAL/offset&#xa;限流 · 断路 · 不阻塞 JVM" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="app-host">
          <mxGeometry x="740" y="55" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sw-agent" value="SkyWalking Java Agent（可选）&#xa;-javaagent · OAP gRPC 28121&#xa;Trace 采样 10–20% prod" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="app-host">
          <mxGeometry x="40" y="200" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="actuator" value="/actuator/prometheus&#xa;仅管理网 / 防火墙白名单&#xa;不经 Gateway 暴露" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="app-host">
          <mxGeometry x="400" y="200" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app-note" value="监控栈故障不得阻塞业务请求&#xa;Alloy 停 → 本地 log 仍写&#xa;Agent 停 → 仅丢 Trace" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="app-host">
          <mxGeometry x="740" y="190" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="disk" value="本地磁盘（真相源）&#xa;logrotate / logback rolling" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="app-host">
          <mxGeometry x="400" y="320" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="mon-host" value="独立监控主机 / 监控集群（内网）" style="swimlane;html=1;startSize=32;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="110" width="940" height="420" as="geometry" />
        </mxCell>
        <mxCell id="prom" value="Prometheus&#xa;scrape 281xx /actuator&#xa;保留 15–30d TSDB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="mon-host">
          <mxGeometry x="40" y="55" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="loki" value="Loki&#xa;ingest + query&#xa;chunk → 对象存储" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="mon-host">
          <mxGeometry x="340" y="55" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="grafana" value="Grafana :443 内网&#xa;Dashboard + Loki Explore&#xa;告警 → 钉钉/企微" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="mon-host">
          <mxGeometry x="640" y="55" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="oap" value="SkyWalking OAP + UI&#xa;BanyanDB/ES 持久卷&#xa;Trace 7d · 错误全采样" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="mon-host">
          <mxGeometry x="40" y="180" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mon-note" value="禁止 docker compose down -v&#xa;配置 Git 管理 · 数据卷/对象存储备份" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="mon-host">
          <mxGeometry x="640" y="170" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="object" value="对象存储（生产必配）&#xa;MinIO / S3 / COS / OSS&#xa;Loki chunks + index · 多 AZ 副本" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="580" width="940" height="90" as="geometry" />
        </mxCell>

        <mxCell id="archive" value="冷归档（可选 · 合规）&#xa;ERROR 日志 gzip → OSS Glacier&#xa;保留 90d–1y · 离线 grep" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="1080" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e-log" value="tail *.log" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="logback" target="alloy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-push" value="push logs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="alloy" target="loki">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-metrics" value="scrape" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="actuator" target="prom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-trace" value="gRPC 28121" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="sw-agent" target="oap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s3" value="S3 API" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="loki" target="object">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-grafana" value="query" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;fontSize=10;dashed=1;" edge="1" parent="1" source="grafana" target="loki">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-grafana2" value="query" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;fontSize=10;dashed=1;" edge="1" parent="1" source="grafana" target="prom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-archive" value="rsync / cron" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#999999;fontSize=10;dashed=1;" edge="1" parent="1" source="disk" target="archive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="PoC（dev）：单机 deploy/observability/docker-compose · Loki filesystem 卷 · 与业务 JVM 同机可接受&#xa;生产：业务机 Alloy + 监控机 Loki/Prometheus/Grafana · Loki 必须对象存储 · 禁止 down -v" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="2080" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
