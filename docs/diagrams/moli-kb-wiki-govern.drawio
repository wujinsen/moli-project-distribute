<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="moli-kb-wiki-govern" name="Wiki 治理工作台">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Wiki 治理工作台 · 链路（T16e）：Lint 文件真值 → 脚本修 metadata → AI 批量修复 → 复检 → Sync；ingest 旁路" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s0" value="① 选空间&#xa;KbSpaceSelector" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="② Lint 文件真值&#xa;POST /kb/wiki/lint-space&#xa;lint.py --wiki-dir" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="dec" value="有问题?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="115" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="healthy" value="健康 → 可选 Sync" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="③ 勾选 issue&#xa;脚本 / AI / 手改 三类&#xa;issue.page = slug" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="105" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="fixScript" value="脚本修复（快）&#xa;POST /kb/wiki/govern/script-fix&#xa;missing_dates / slug_mismatch / missing_source&#xa;不调 LLM" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1020" y="40" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="fixAi" value="AI 批量修复&#xa;POST /kb/wiki/govern/ai-batch-fix&#xa;broken_link / orphan / …&#xa;kb.llm + 写盘" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="140" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="fixAuto" value="一键 auto-fix&#xa;POST /kb/wiki/govern/auto-fix&#xa;脚本 → AI → 自动 relint&#xa;可选 syncAfter" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="240" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="fixManual" value="dup 合并 / 手改&#xa;POST /kb/wiki/govern/merge-hint&#xa;或 /knowledge/wiki/edit&#xa;不调 LLM 批量 enrich" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="340" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="④ Lint 复检&#xa;lint-space 或 auto-fix 内置&#xa;问题数 before → after" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="120" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="⑤ Sync&#xa;POST /kb/sync/trigger&#xa;或 auto-fix syncAfter" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1640" y="120" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="db" value="MySQL kb_document" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1920" y="125" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="bypass" value="旁路：Ingest 工作台&#xa;raw → Plan → 草稿 → commit → Sync" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="note" value="已废弃（勿在治理页做）：批量 POST /kb/wiki/enrich。Enrich 仅 T14 单页编辑或 Ingest Plan enrich[]。&#xa;契约：docs/api/wiki-govern-frontend.md · 脚本 vs LLM：docs/test/knowledge-script-vs-llm-matrix.md" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f8f8f8;strokeColor=#cccccc;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="380" width="1100" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
