        <mxCell id="e4c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="s2" target="fixManual"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="fixScript" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="fixAi" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="fixAuto" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="fixManual" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
