<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="operation-topology-graph" name="Server Topology Visualization">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="服务器拓扑可视化（SVR-25）&#xa;全局拓扑图 P1 · 弹窗增强 P1.5 · 依赖边 P2" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="620" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="ui" value="meiling-ui · TopologyGraphView&#xa;operation/topology/index&#xa;─────────────&#xa;ECharts graph（force / circular）&#xa;节点：服务器 / 项目 / 组件&#xa;着色：status · deployRunning&#xa;边：deploys（端口 label）&#xa;筛选：环境 / serverRole / tag / 关键字&#xa;深链 ?serverId= · saveAsImage 导出" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="modal" value="ServerDetailModal（复用）&#xa;─────────────&#xa;点服务器节点打开只读详情&#xa;P1.5：单机拓扑弹窗叠加&#xa;deployRunning / portMatchStatus&#xa;+ 最近任务 5 条" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="280" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="gw" value="moli-gateway :21000&#xa;─────────────&#xa;/UserCenter/**（StripPrefix=1）&#xa;Authorization = Shiro SessionId" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="130" width="240" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="svc" value="moli-user-center :8888&#xa;OperationTopologyService（新增）&#xa;─────────────&#xa;GET /operation/topology&#xa;perms operation:server:list&#xa;三表全量 + 两张 N:N 聚合&#xa;N:N 空回退主 server_id（SVR-22）&#xa;portMatchStatus ← PortMatrixProvider&#xa;节点 id 前缀 s- / p- / c-" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="280" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="dbgroup" value="MySQL · 运维台账表" style="swimlane;startSize=28;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="640" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="t_server" value="operation_server_info&#xa;─────────────&#xa;id / server_name / ip&#xa;environment / status&#xa;server_role（SVR-23）&#xa;tags JSON（SVR-24）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="dbgroup">
          <mxGeometry x="20" y="45" width="190" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t_project" value="operation_project_deploy_info&#xa;─────────────&#xa;id / project_name / port&#xa;server_id（主）&#xa;deploy_running（SVR-8）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="dbgroup">
          <mxGeometry x="230" y="45" width="195" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t_component" value="operation_component_deploy_info&#xa;─────────────&#xa;id / component_name / port&#xa;server_id（主）/ status&#xa;端口校验 ← 端口矩阵（SVR-21）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="dbgroup">
          <mxGeometry x="440" y="45" width="185" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t_sp" value="operation_server_project&#xa;─────────────&#xa;server_id / project_id&#xa;（SVR-22 N:N）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dbgroup">
          <mxGeometry x="20" y="200" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="t_sc" value="operation_server_component&#xa;─────────────&#xa;server_id / component_id&#xa;（SVR-22 N:N）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dbgroup">
          <mxGeometry x="230" y="200" width="195" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="t_pc" value="operation_project_component&#xa;─────────────&#xa;project_id / component_id / remark&#xa;（P2 新表 · 依赖边 depends_on）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="dbgroup">
          <mxGeometry x="440" y="200" width="185" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="db_note" value="逻辑外键、无物理 FK；级联清理走 OperationServerCascadeSupport" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="dbgroup">
          <mxGeometry x="20" y="310" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="er1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="dbgroup" source="t_sp" target="t_server">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="er2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="dbgroup" source="t_sp" target="t_project">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="er3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="dbgroup" source="t_sc" target="t_component">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="er4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#999999;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="dbgroup" source="t_pc" target="t_component">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_ui_gw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="ui" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_ui_gw_l" value="GET /UserCenter/operation/topology" style="edgeLabel;html=1;align=center;fontSize=10;" vertex="1" connectable="0" parent="e_ui_gw">
          <mxGeometry relative="1" x="-0.4" as="geometry"><mxPoint y="-14" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e_gw_svc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" parent="1" source="gw" target="svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_gw_svc_l" value="REST（StripPrefix）" style="edgeLabel;html=1;align=center;fontSize=10;" vertex="1" connectable="0" parent="e_gw_svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_svc_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="svc" target="dbgroup">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_svc_db_l" value="JDBC（MyBatis-Plus）" style="edgeLabel;html=1;align=center;fontSize=10;" vertex="1" connectable="0" parent="e_svc_db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_ui_modal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#9673a6;" edge="1" parent="1" source="ui" target="modal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_ui_modal_l" value="点服务器节点" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#9673a6;" vertex="1" connectable="0" parent="e_ui_modal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="phases" value="分期：P1 全局图（无新表） → P1.5 单机拓扑弹窗叠加 deployRunning / portMatchStatus / 最近任务（无新表） → P2 operation_project_component 依赖边（1 张 N:N） → P3 SSH facts（白名单命令、不落库）+ 探测历史表&#xa;非目标：自动服务发现 / APM 链路追踪 / WebSocket 实时推送" style="text;html=1;strokeColor=#999999;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1400" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
