        <mxCell id="runtime" value="&lt;b&gt;KbLlmRuntime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;DB 优先 → yaml 兜底&lt;br&gt;PUT 后 refresh 内存&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="server_lane">
          <mxGeometry x="220" y="45" width="170" height="70" as="geometry" />
