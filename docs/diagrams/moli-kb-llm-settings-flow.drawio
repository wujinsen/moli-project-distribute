        <mxCell id="client" value="&lt;b&gt;KbLlmClient&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Ask · Ingest · Wiki ai-revise&lt;br&gt;OpenAI /chat/completions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="server_lane">
          <mxGeometry x="120" y="150" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ask_probe" value="GET /kb/ask/llm-config&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;available（无 key）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="server_lane">
