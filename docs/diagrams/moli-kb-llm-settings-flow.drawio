        <mxCell id="note" value="&lt;b&gt;一期非目标&lt;/b&gt;：moli-ai 独立服务 · 按空间多套 Key · 用户自带 Key" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffcc;strokeColor=#d6b656;size=12;align=left;" vertex="1" parent="1">
