        <mxCell id="yaml" value="&lt;font style=&quot;font-size:10px;&quot;&gt;kb.llm.* yaml/Nacos&lt;br&gt;冷启动兜底（不写 key 回 Git）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="data_lane">
