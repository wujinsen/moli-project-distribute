<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="moli-kb-llm-settings" name="KB LLM Platform Settings">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;知识库 LLM · 平台系统设置（T19）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666;&quot;&gt;配置存 MySQL · 全站 Ask/Ingest/Wiki 治理共用 · 不放 moli-ai&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ui_lane" value="meiling-ui · 平台系统管理" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;startSize=28;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="320" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="平台管理员&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;superadmin / kb:platform:llm&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="ui_lane">
          <mxGeometry x="30" y="50" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="settings_page" value="&lt;b&gt;系统管理 → 知识库 LLM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;enabled · provider · base-url&lt;br&gt;api-key（脱敏）· model · timeout&lt;br&gt;保存 · 测试连接&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ui_lane">
          <mxGeometry x="90" y="45" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="consumers_ui" value="&lt;font style=&quot;font-size:10px;&quot;&gt;消费页（只读探测）&lt;br&gt;Ask · Ingest Express · Wiki 治理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="ui_lane">
          <mxGeometry x="40" y="180" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="server_lane" value="moli-knowledge-server :8090" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=28;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="420" height="320" as="geometry" />
