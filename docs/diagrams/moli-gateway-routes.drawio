        <mxCell id="e1" value="/UserCenter/**" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="gw" target="uc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="/OrderServer/**" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;" edge="1" parent="1" source="gw" target="order"><mxGeometry relative="1" as="geometry"/></mxCell>
