<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="gw-routes" name="Gateway Routes">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="茉莉网关路由一览&#xa;moli-gateway :21000 · StripPrefix=1 · lb://Nacos" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1">
