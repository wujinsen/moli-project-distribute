          <mxGeometry x="240" y="90" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="uc" value="user-center-server&#xa;:8888 HTTP · :20881 Dubbo&#xa;lb://user-center-server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="200" height="70" as="geometry"/>
