          <mxGeometry x="520" y="340" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="tbl" value="路由表（application-dev.yml）&#xa;─────────────────────────&#xa;/UserCenter/**      → user-center-server&#xa;/OrderServer/**     → order-server&#xa;/BiServer/**        → bi-server&#xa;/KnowledgeServer/** → knowledge-server&#xa;&#xa;过滤器：StripPrefix=1（去掉第一段路径）&#xa;例：/OrderServer/seckill/order → order-server /seckill/order" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="380" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="nacos" value="Nacos :8848&#xa;服务发现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
