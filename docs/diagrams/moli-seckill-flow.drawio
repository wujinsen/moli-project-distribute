<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="seckill" name="Seckill Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1300" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="秒杀全链路&#xa;Gateway → order-server → Redis Lua 扣库存 → 异步落库 MySQL" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1">
