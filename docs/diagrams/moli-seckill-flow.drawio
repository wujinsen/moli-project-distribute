        </mxCell>
        <mxCell id="note" value="成功路径：200 + 订单受理&#xa;库存不足：快速失败（Redis）&#xa;压测：load-test/ + guides/秒杀压测指南" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
