        <mxCell id="worker" value="消费者/异步任务&#xa;落库订单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="930" y="115" width="130" height="60" as="geometry"/>
