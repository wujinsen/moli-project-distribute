        <mxCell id="order" value="order-server :8087&#xa;Shiro 校验 Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="115" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lua" value="Redis Lua 脚本&#xa;原子检查库存 + 扣减&#xa;防超卖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
