<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="rbac" name="RBAC Model">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="RBAC 权限模型（user-center）&#xa;Shiro + Redis Session · sys_action 动作权限" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="550" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="SysUser&#xa;─────────&#xa;userName · password&#xa;deptId → SysDept" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="role" value="SysRole&#xa;─────────&#xa;roleName · status" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="menu" value="SysMenu&#xa;─────────&#xa;M目录 / C菜单 / F按钮&#xa;path · component · perms" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="90" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="dept" value="SysDept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ur" value="sys_user_role&#xa;N:N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="110" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rm" value="sys_role_menu&#xa;N:N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="540" y="110" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="action" value="sys_action + sys_role_action&#xa;页面级动作（如 system:user:add）&#xa;与 menu perms 并集 → Shiro" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="flow" value="运行时鉴权&#xa;─────────────────&#xa;1. 登录 → Shiro Session → Redis db=2&#xa;2. 业务请求 Authorization=sessionId&#xa;3. @RequiresPermissions / perms 校验&#xa;4. superadmin/admin → *:*:*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="fe" value="前端&#xa;getRouters → 侧栏&#xa;capabilities → 按钮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="480" y="340" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gw2" value="各业务服务&#xa;Shiro Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="680" y="340" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="" style="endArrow=block;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="user" target="ur"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" value="" style="endArrow=block;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="ur" target="role"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" value="" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="role" target="rm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4" value="" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="rm" target="menu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r5" value="deptId" style="endArrow=open;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="user" target="dept"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r6" value="" style="endArrow=open;html=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="role" target="action"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
