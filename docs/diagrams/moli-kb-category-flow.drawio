        <mxCell id="m_fm" value="&lt;b&gt;frontmatter&lt;/b&gt;&#xa;─────────────&#xa;type: guide&#xa;(移分类时按&#xa;default_type 改)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=0;" vertex="1" parent="model">
          <mxGeometry x="660" y="40" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m_note" value="&lt;font style=&quot;font-size:10px;&quot;&gt;浏览左树 groupBy=category 读 category_id 分组&#xa;groupBy=type 仍读 kb_type（体裁，退居幕后）&#xa;裸名 [[wikilink]] 因 stem 不变，移目录不破坏&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="model">
          <mxGeometry x="850" y="45" width="380" height="70" as="geometry" />
        </mxCell>
