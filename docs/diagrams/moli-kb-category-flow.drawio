        <mxCell id="me3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;dashed=1;" edge="1" parent="model" source="m_fm" target="m_dir"><mxGeometry relative="1" as="geometry" /></mxCell>
