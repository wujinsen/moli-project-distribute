  <diagram id="kb-category-flow" name="Category Management Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;知识库 · 分类管理流程（分类 = 目录 · 单一真相源）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666;&quot;&gt;kb_category.dir_slug ↔ wiki 子目录 ↔ kb_document.category_id · 三空间 enterprise-kb / moli-ops-manual / jp-fe-ap-exam · 2026-06-27&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="900" height="45" as="geometry" />
        </mxCell>
        <mxCell id="model" value="&lt;b&gt;数据模型（Sync 时按一级目录回填 category_id）&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;startSize=28;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="m_cat" value="&lt;b&gt;kb_category&lt;/b&gt;&#xa;─────────────&#xa;space_id&#xa;category_name&#xa;dir_slug (唯一)&#xa;default_type&#xa;sort / icon" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=0;" vertex="1" parent="model">
          <mxGeometry x="30" y="40" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m_dir" value="&lt;b&gt;wiki 子目录&lt;/b&gt;&#xa;─────────────&#xa;kb/wiki/guides/&#xa;kb/wiki-ops/services/&#xa;…&#xa;*.md 文件" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" vertex="1" parent="model">
          <mxGeometry x="240" y="40" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m_doc" value="&lt;b&gt;kb_document&lt;/b&gt;&#xa;─────────────&#xa;slug = dir/stem&#xa;category_id&#xa;kb_type (体裁)&#xa;source='kb'" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=0;" vertex="1" parent="model">
