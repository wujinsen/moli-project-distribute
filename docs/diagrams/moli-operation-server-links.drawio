        </mxCell>
        <mxCell id="sp" value="operation_server_project&#xa;─────────────&#xa;server_id (FK)&#xa;project_id (FK)&#xa;uk(server, project)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sc" value="operation_server_component&#xa;─────────────&#xa;server_id (FK)&#xa;component_id (FK)&#xa;uk(server, component)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
