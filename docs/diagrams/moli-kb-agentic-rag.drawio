        <mxCell id="eval" value="eval_ask.py --compare-agentic · dirty+multi-hop 子集 · hit@k / coverage / 延迟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
