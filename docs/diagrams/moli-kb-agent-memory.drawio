<mxfile host="app.diagrams.net" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="moli-kb-agent-memory" name="Session Context Memory">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;知识库对话：会话 / 上下文 / 记忆（规划 AI-11）&lt;/b&gt;&#xa;&lt;font style=&quot;font-size:11px;color:#666;&quot;&gt;Shiro 登录会话 ≠ Agent 聊天会话 · 单轮 /kb/ask 保持不变 · 多轮走 /kb/chat&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="48" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;meiling-ui 知识库对话&lt;/b&gt;&#xa;Authorization = Shiro sessionId&#xa;body.chatSessionId = s-8821" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;moli-gateway :21000&lt;/b&gt;&#xa;/KnowledgeServer/** StripPrefix=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ks" value="&lt;b&gt;knowledge-server&lt;/b&gt;&#xa;KbChatService 打包上下文&#xa;再调既有 KbAskService.ask()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pack" value="&lt;b&gt;上下文打包（token 预算）&lt;/b&gt;&#xa;1 系统规则 + Guardrails&#xa;2 长期记忆 top-M（按 userId 检索）&#xa;3 会话摘要（旧轮压缩）&#xa;4 最近 K 轮原文&#xa;5 RAG 片段 llmContextTopK&#xa;超限：先砍历史原文，再砍记忆，规则与当前问不砍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="64" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="ui" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="gw" target="ks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="ks" target="pack"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mysql" value="&lt;b&gt;MySQL kb_chat_*&lt;/b&gt;&#xa;kb_chat_session&#xa;kb_chat_message&#xa;kb_user_memory（事实文本）&#xa;kb_qa_log 仍记单轮审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&#xa;热会话最近 K 轮&#xa;TTL = 会话空闲超时&#xa;前缀 kb:chat:{sessionId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="280" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="chroma" value="&lt;b&gt;kb-retrieval Chroma&lt;/b&gt;&#xa;collection: moli_user_memory_v1&#xa;metadata: userId, memoryId&#xa;复用 POST /embed + /search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="280" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;KbLlmClient&lt;/b&gt;&#xa;生成答案（带 citations）&#xa;异步：抽取记忆 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="280" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="读写消息" style="endArrow=block;html=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="ks" target="mysql"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="220"/><mxPoint x="160" y="220"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="热路径" style="endArrow=block;html=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="ks" target="redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="240"/><mxPoint x="430" y="240"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="P2 记忆检索" style="endArrow=block;html=1;strokeColor=#b85450;dashed=1;fontSize=10;" edge="1" parent="1" source="pack" target="chroma"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="220"/><mxPoint x="700" y="220"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="pack" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="抽取后写入" style="endArrow=block;html=1;strokeColor=#b85450;dashed=1;fontSize=10;" edge="1" parent="1" source="llm" target="chroma"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="430"/><mxPoint x="700" y="430"/></Array></mxGeometry></mxCell>
        <mxCell id="note" value="P0：session + 最近 K 轮注入 Ask，不改 /kb/ask 契约。&#xa;P1：摘要 + token 预算。&#xa;P2：长期记忆抽取/召回（与 wiki 向量 collection 隔离）。&#xa;P3：Agentic / Research / AIOps 可选挂同一 chatSessionId。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1040" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
