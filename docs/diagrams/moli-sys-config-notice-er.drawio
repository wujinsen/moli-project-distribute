<mxfile host="app.diagrams.net" modified="2026-08-16T01:30:00.000Z" agent="moli-docs" version="22.1.0" type="device">
  <diagram id="moli-sys-config-notice-er" name="Config &amp; Notice ER">
    <mxGraphModel dx="1700" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="参数设置 · 通知公告 · ER 图（新增 3 表）&#xa;设计要点：参数「声明在代码、覆盖值在 DB」· 公告未读用水位表而非 N×M 关联表&#xa;逻辑外键（无物理 FK）· ★ = 本次新建 · 灰虚线框 = 已存在的外部/复用表" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="70" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="设计决策（详见 docs/design/sys-config-notice.md）&#xa;─────────────&#xa;· 参数集合有限且由代码声明 → 表塌缩为 key→value&#xa;· 删除一行 = 重置为默认（行不存在即默认）&#xa;· UI 不可新增参数 → 无 system:config:add 权限&#xa;· 无分页（数十条量级）&#xa;· 不加 system_id（参数天然全平台）&#xa;· notice_content 存 Markdown 源文&#xa;· 未读用水位表：行数=用户数, 不随公告数增长&#xa;&#xa;范式对齐 sys_post / sys_dict_data&#xa;· create_id / update_id 为 bigint（非 create_by）&#xa;· 无 del_flag（物理删除）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="400" height="240" as="geometry" />
        </mxCell>

        <mxCell id="registry" value="ConfigKey 注册表 ★ 代码侧（非 DB）&#xa;─────────────&#xa;enum ConfigKey&#xa;· key            沿用现有 yaml 路径&#xa;· valueType      BOOLEAN|INT|STRING&#xa;· defaultValue   声明的默认值&#xa;· group          SECURITY|PORTAL|OPS&#xa;· description    参数说明&#xa;─────────────&#xa;首批 4 个（全为布尔开关）：&#xa;      captcha.enabled&#xa;      sso.enabled&#xa;      ops.command.enabled&#xa;      ops.health.probe-enabled&#xa;新增参数 = 加枚举常量，无需 SQL" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="110" width="360" height="240" as="geometry" />
        </mxCell>

        <mxCell id="chain" value="ConfigService 取值链（四级回落）&#xa;─────────────&#xa;① Redis   sys_config:{key}&#xa;② MySQL   sys_config（回填 Redis）&#xa;③ Environment  yaml / 未来 Nacos&#xa;④ ConfigKey 声明的默认值&#xa;─────────────&#xa;只用 Redis 缓存，无进程内本地缓存&#xa;→ 多实例下不产生一致性问题&#xa;写路径：先写 MySQL → DEL sys_config:{key}&#xa;无 TTL（写后失效比过期兜底可靠）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="110" width="340" height="240" as="geometry" />
        </mxCell>

        <mxCell id="boundary" value="不进 sys_config 的配置（边界 · 最重要）&#xa;─────────────&#xa;数据源/端口/Redis 地址 → yaml / Nacos&#xa;  （进 DB 会形成读配置需先连 DB 的循环）&#xa;平台 LLM 配置 → kb_platform_llm_config（已存在）&#xa;服务器/平台凭据 → operation_platform（已加密）&#xa;业务枚举 → sys_dict_*（已存在）&#xa;─────────────&#xa;没有这条边界，sys_config 会变成垃圾抽屉" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="110" width="370" height="240" as="geometry" />
        </mxCell>

        <mxCell id="ext_user" value="sys_user&#xa;(user-center · 外部)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="470" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="Redis db=2（参数缓存）&#xa;─────────────&#xa;key: sys_config:{configKey}&#xa;Constants.SYS_CONFIG_KEY（已存在未使用）&#xa;无 TTL · 写后 DEL&#xa;缺失则回落 ②③④" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="sys_config" value="sys_config ★ 新建（仅存运行期覆盖值）&#xa;─────────────&#xa;id            PK（雪花 ASSIGN_ID）&#xa;config_key    UK · 必须是已声明的 key&#xa;config_value  varchar(2048) NOT NULL&#xa;create_id · create_time&#xa;update_id · update_time&#xa;─────────────&#xa;UK uk_sys_config_key(config_key)&#xa;─────────────&#xa;业务列只有 2 个&#xa;无 config_name / value_type / config_type&#xa;无 status / group_code / remark&#xa;（以上均属代码知识，在注册表里）&#xa;迁移种子为空表：任何初始行都意味着&#xa;一上线就覆盖了默认值" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="440" width="360" height="290" as="geometry" />
        </mxCell>

        <mxCell id="sys_notice" value="sys_notice ★ 新建&#xa;─────────────&#xa;id             PK（雪花 ASSIGN_ID）&#xa;notice_title   varchar(255)&#xa;notice_type    → 字典 sys_notice_type&#xa;notice_content mediumtext（Markdown 源文）&#xa;status         0草稿 1已发布 2已撤回&#xa;top_flag       1置顶 0普通&#xa;publish_time   发布动作写入&#xa;expire_time    NULL=长期有效&#xa;create_id · create_time&#xa;update_id · update_time&#xa;─────────────&#xa;IDX idx_sys_notice_publish(status, publish_time)&#xa;─────────────&#xa;无 remark（公告本身就是内容）&#xa;无维护窗口字段（expire_time 已够，&#xa;为倒计时预留结构属投机性设计）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="440" width="360" height="330" as="geometry" />
        </mxCell>

        <mxCell id="cursor" value="sys_notice_read_cursor ★ 新建（未读水位）&#xa;─────────────&#xa;user_id        PK · → sys_user.id&#xa;last_read_time 已读时间水位&#xa;update_time&#xa;─────────────&#xa;未读数 = count(status=1&#xa;  AND publish_time &gt; last_read_time&#xa;  AND (expire_time IS NULL OR &gt; now()))&#xa;─────────────&#xa;行数 = 用户数，不随公告数增长&#xa;O(用户) 而非 O(用户×公告)&#xa;代价：无法乱序标记单条已读&#xa;（通知栏场景下是恰当取舍）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="440" width="360" height="290" as="geometry" />
        </mxCell>

        <mxCell id="sys_dict" value="sys_dict_type / sys_dict_data（已存在种子 · 复用）&#xa;─────────────&#xa;sys_dict_type.id=9  dict_type='sys_notice_type'&#xa;901 dict_key=1 → 通知&#xa;902 dict_key=2 → 公告&#xa;903 dict_key=3 → 维护&#xa;前端下拉调 /dict/data/type/{dictType}&#xa;→ 公告类型不硬编码枚举" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="840" width="360" height="150" as="geometry" />
        </mxCell>

        <mxCell id="sys_menu" value="sys_menu（已存在 · 无需改动）&#xa;─────────────&#xa;id=8 参数设置&#xa;· parent_id=1（系统管理）&#xa;· path=config&#xa;· component=system/config/index&#xa;· perms=system:config:list&#xa;&#xa;id=9 通知公告&#xa;· parent_id=1（系统管理）&#xa;· path=notice&#xa;· component=system/notice/index&#xa;· perms=system:notice:list" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="840" width="360" height="230" as="geometry" />
        </mxCell>

        <mxCell id="sys_action" value="sys_action ★ 新增 5 行&#xa;─────────────&#xa;menu_id=8（参数设置）&#xa;· system:config:edit&#xa;· system:config:remove（语义=重置为默认）&#xa;menu_id=9（通知公告）&#xa;· system:notice:add&#xa;· system:notice:edit&#xa;· system:notice:remove&#xa;─────────────&#xa;无 system:config:add：参数不能由 UI 创建，&#xa;造一个永不校验的权限码只会让角色授权页&#xa;出现无效勾选项&#xa;list 权限由 sys_menu.perms 承载" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="840" width="360" height="250" as="geometry" />
        </mxCell>

        <mxCell id="role_menu" value="sys_role_menu ★ 必须补种子&#xa;─────────────&#xa;当前仅 test 角色(720354230530998272)&#xa;授权菜单 8 / 9&#xa;角色 1 / 2 一行都没有&#xa;→ 不补则上线后管理员看不到入口&#xa;&#xa;本表**无 (role_id,menu_id) 唯一约束**&#xa;→ 用显式语义化 id + ON DUPLICATE KEY 保幂等&#xa;→ 且不可重复插 test 角色（会产生重复行）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="360" height="150" as="geometry" />
        </mxCell>

        <mxCell id="e_registry_config" value="声明约束 key&#xa;（写入时校验已声明）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#9673a6;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="registry" target="sys_config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_chain_config" value="② 读覆盖值" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#82b366;fontSize=10;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="chain" target="sys_config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_config_redis" value="写后 DEL&#xa;读 miss 回填" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#b85450;fontSize=10;exitX=0;exitY=0.6;exitDx=0;exitDy=0;" edge="1" parent="1" source="sys_config" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_user_config" value="create_id / update_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#999999;fontSize=10;" edge="1" parent="1" source="ext_user" target="sys_config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_dict_notice" value="dict_key → notice_type&#xa;（枚举来源）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#6c8ebf;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_dict" target="sys_notice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_notice_cursor" value="publish_time 与水位比较&#xa;得未读数（索引范围扫描）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#d6b656;fontSize=10;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_notice" target="cursor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_user_cursor" value="user_id PK&#xa;（一用户一行）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#999999;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ext_user" target="cursor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_menu_config" value="perms 页面权限" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#82b366;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_menu" target="sys_config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_menu_action" value="menu_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="sys_menu" target="sys_action">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_menu_rolemenu" value="角色授权" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="sys_menu" target="role_menu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_action_notice" value="按钮权限" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#82b366;fontSize=10;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_action" target="sys_notice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
