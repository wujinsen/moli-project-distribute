# Shell scripts must use LF so Linux/macOS shebang works (avoid bash\r error)
*.sh text eol=lf
moli-knowledge/kb/tools/**/*.sh text eol=lf

# KB CLI tools run on Linux CI/EC2; CRLF breaks `#!/usr/bin/env python3`
moli-knowledge/kb/tools/**/*.py text eol=lf
moli-knowledge/kb/tools/*.py text eol=lf

# SQL seeds often edited on Windows; keep UTF-8 LF for mysql source
docs/sql/*.sql text eol=lf
